# Copy to .env.local and fill in. Vite only exposes VITE_* vars to the browser.
#
# From your Supabase project: Settings -> API.
# Both values are publishable and safe in a client bundle.
# NEVER put the Postgres password or the service_role key here — anything
# VITE_* is compiled into the JavaScript every visitor downloads.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
